{
  "name": "taovate-site",
  "version": "1.0.0",
  "private": true,
  "description": "韬维 Taovate 官网：纯静态站点，Tailwind 编译，部署到 Cloudflare Workers（静态资源）",
  "scripts": {
    "build:vendor": "node scripts/copy-vendor.mjs",
    "build:css": "tailwindcss -i src/input.css -o public/taovate.css --minify",
    "build:seo": "node scripts/build-seo.mjs",
    "build": "npm run build:vendor && npm run build:css && npm run build:seo",
    "check": "node scripts/check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && npm run check && wrangler deploy"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-serif-sc": "5.3.1",
    "@fontsource/spectral": "5.3.0",
    "alpinejs": "3.17.4",
    "tailwindcss": "3.4.17",
    "wrangler": "^4.151.2"
  }
}
